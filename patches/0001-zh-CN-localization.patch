diff --git a/components/KnowYourConstellation/src/panel.lua b/components/KnowYourConstellation/src/panel.lua
index f78e8f3..5f7fbef 100644
--- a/components/KnowYourConstellation/src/panel.lua
+++ b/components/KnowYourConstellation/src/panel.lua
@@ -16,6 +16,25 @@ end
 
 -- Remove fully offscreen glyphs. Opaque padding clips partial edge glyphs,
 -- letting the text move in pixels without drawing outside our own strip.
+-- Localised build: the marquee walks *characters*, not bytes. starts[i] is the
+-- byte index where character i begins, starts[n+1] == #text+1. Plain ASCII text
+-- yields exactly one entry per byte, so the original behaviour is unchanged.
+local function char_starts(text)
+    local starts = {}
+    local n = #text
+    local i = 1
+    while i <= n do

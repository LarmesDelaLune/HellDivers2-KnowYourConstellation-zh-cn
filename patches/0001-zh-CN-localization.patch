diff --git a/components/KnowYourConstellation/src/model.lua b/components/KnowYourConstellation/src/model.lua
index 039d9e6..30851a7 100644
--- a/components/KnowYourConstellation/src/model.lua
+++ b/components/KnowYourConstellation/src/model.lua
@@ -1,8 +1,10 @@
 local M = {}
 
 function M.ascii(text)
-    assert(type(text) == 'string' and not text:find('[^\32-\126]') and not text:find(';', 1, true),
-        'Display text must be plain ASCII without semicolons')
+    -- Localised build: allow any printable non-ASCII text (CJK), still reject
+    -- control characters and semicolons, which the marquee parser relies on.
+    assert(type(text) == 'string' and not text:match('[%z\1-\31\127]') and not text:find(';', 1, true),
+        'Display text must not contain control characters or semicolons')
     return text
 end
 
@@ -16,27 +18,27 @@ function M.make(snapshot, catalogue)
     end
     if #cards == 0 then
         if snapshot.complete and #snapshot.tags==0 then
-            cards[1] = {title='STANDARD FORCES', detail='No special constellation selected'}
+            cards[1] = {title='常规部队', detail='未选中特殊敌军编组'}
         else
